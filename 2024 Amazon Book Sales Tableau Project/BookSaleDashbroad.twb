            <column-instance column='[Quadrant (copy)_3686389592408068]' derivation='None' name='[none:Quadrant (copy)_3686389592408068:nk]' pivot='key' type='nominal' />
            <column-instance column='[Review Count]' derivation='Sum' name='[sum:Review Count:qk]' pivot='key' type='quantitative' />
