      <column caption='Max Price per Genre' datatype='real' name='[Calculation_1125350861963264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Genre] : MAX([Price]) }' />
      </column>
      <column caption='Max Price Title' datatype='string' name='[Calculation_1125350862135297]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Genre] :&#13;&#10;    MIN(&#13;&#10;        IF [Price] = [Calculation_1125350861963264]&#13;&#10;        AND [Review Count] = [Calculation_3686390057381903]&#13;&#10;        THEN [Title]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Max Price Title Author' datatype='string' name='[Calculation_1125351071973378]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Genre] :&#13;&#10;    MIN(&#13;&#10;        IF [Price] = [Calculation_1125350861963264]&#13;&#10;        AND [Review Count] = [Calculation_3686390057381903]&#13;&#10;        THEN [Author]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Median Reviews' datatype='real' name='[Calculation_3686389278408705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MEDIAN([Reviews]) }' />
      </column>
      <column caption='Median Review Count' datatype='real' name='[Calculation_3686389278535682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MEDIAN([Review Count]) }' />
      </column>
      <column caption='Quadrant' datatype='string' name='[Calculation_3686389279461379]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Reviews] &gt;= [Calculation_3686389278408705]&#13;&#10;AND [Review Count] &gt;= [Calculation_3686389278535682] THEN &quot;High Rating / High Reviews&quot;&#13;&#10;&#13;&#10;ELSEIF [Reviews] &gt;= [Calculation_3686389278408705]&#13;&#10;AND [Review Count] &lt; [Calculation_3686389278535682] THEN &quot;High Rating / Low Reviews&quot;&#13;&#10;&#13;&#10;ELSEIF [Reviews] &lt; [Calculation_3686389278408705]&#13;&#10;AND [Review Count] &gt;= [Calculation_3686389278535682] THEN &quot;Low Rating / High Reviews&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low Rating / Low Reviews&quot;&#13;&#10;END' />
      </column>
      <column caption='Max Review Count at Max Price' datatype='integer' name='[Calculation_3686390057381903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Genre] :&#13;&#10;    MAX(&#13;&#10;        IF [Price] = [Calculation_1125350861963264] THEN [Review Count] END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column datatype='string' name='[Genre]' role='dimension' type='nominal' />
      <column caption='Median Avg. Reviews' datatype='real' name='[Median Avg. Price (copy)_3686389597466633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MEDIAN([Median Avg. Reviews (copy)_3686389724065806]) }' />
      </column>
      <column caption='Avg. Price' datatype='real' name='[Median Avg. Price (copy)_3686389724041229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Genre] : AVG([Price]) }' />
      </column>
      <column caption='Avg. Reviews' datatype='real' name='[Median Avg. Reviews (copy)_3686389724065806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Genre] : AVG([Reviews]) }' />
      </column>
      <column caption='Median Avg. Price' datatype='real' name='[Median Review Count (copy)_3686389593395205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MEDIAN({ FIXED [Genre] : AVG([Price]) }) }' />
      </column>
      <column datatype='integer' name='[Number of Pages]' role='measure' type='quantitative' />
      <column caption='Quadrant PR' datatype='string' name='[Quadrant (copy)_3686389592408068]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Median Avg. Reviews (copy)_3686389724065806] &gt;= [Median Avg. Price (copy)_3686389597466633]&#13;&#10;AND [Median Avg. Price (copy)_3686389724041229] &gt;= [Median Review Count (copy)_3686389593395205] THEN &quot;High Rating / High Price&quot;&#13;&#10;&#13;&#10;ELSEIF [Median Avg. Reviews (copy)_3686389724065806] &gt;= [Median Avg. Price (copy)_3686389597466633]&#13;&#10;AND [Median Avg. Price (copy)_3686389724041229] &lt; [Median Review Count (copy)_3686389593395205] THEN &quot;High Rating / Low Price&quot;&#13;&#10;&#13;&#10;ELSEIF [Median Avg. Reviews (copy)_3686389724065806] &lt; [Median Avg. Price (copy)_3686389597466633]&#13;&#10;AND [Median Avg. Price (copy)_3686389724041229] &gt;= [Median Review Count (copy)_3686389593395205] THEN &quot;Low Rating / High Price&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low Rating / Low Price&quot;&#13;&#10;END' />
      </column>
